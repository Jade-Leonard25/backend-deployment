{
  "name": "deploy-craft-server-input",
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/worker.ts\"",
    "build": "tsc --noEmit && esbuild src/index.ts src/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "prestart": "npm run build",
    "start": "concurrently \"node dist/index.js\" \"node dist/worker.js\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@types/dotenv": "^6.1.1",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^1.0.0-rc.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}